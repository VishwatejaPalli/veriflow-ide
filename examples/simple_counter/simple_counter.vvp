#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x5616afb1ed80 .scope module, "simple_counter_tb" "simple_counter_tb" 2 3;
 .timescale -9 -12;
P_0x5616afb1ef10 .param/l "WIDTH" 1 2 4, +C4<00000000000000000000000000000100>;
v0x5616afb333e0_0 .var "clk", 0 0;
v0x5616afb334b0_0 .var "rst_n", 0 0;
v0x5616afb33580_0 .net "value", 3 0, v0x5616afb33270_0;  1 drivers
S_0x5616afb1efb0 .scope module, "dut" "simple_counter" 2 10, 3 2 0, S_0x5616afb1ed80;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst_n";
    .port_info 2 /OUTPUT 4 "value";
P_0x5616afb1f190 .param/l "WIDTH" 0 3 3, +C4<00000000000000000000000000000100>;
v0x5616afb0ce20_0 .net "clk", 0 0, v0x5616afb333e0_0;  1 drivers
v0x5616afb331b0_0 .net "rst_n", 0 0, v0x5616afb334b0_0;  1 drivers
v0x5616afb33270_0 .var "value", 3 0;
E_0x5616afb1e2e0 .event posedge, v0x5616afb0ce20_0;
    .scope S_0x5616afb1efb0;
T_0 ;
    %wait E_0x5616afb1e2e0;
    %load/vec4 v0x5616afb331b0_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 4;
    %assign/vec4 v0x5616afb33270_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x5616afb33270_0;
    %addi 1, 0, 4;
    %assign/vec4 v0x5616afb33270_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x5616afb1ed80;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5616afb333e0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5616afb334b0_0, 0, 1;
    %end;
    .thread T_1;
    .scope S_0x5616afb1ed80;
T_2 ;
    %delay 5000, 0;
    %load/vec4 v0x5616afb333e0_0;
    %inv;
    %store/vec4 v0x5616afb333e0_0, 0, 1;
    %jmp T_2;
    .thread T_2;
    .scope S_0x5616afb1ed80;
T_3 ;
    %vpi_call 2 20 "$dumpfile", "examples/simple_counter/simple_counter.vcd" {0 0 0};
    %vpi_call 2 21 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5616afb1ed80 {0 0 0};
    %vpi_call 2 23 "$display", "Starting simulation..." {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5616afb334b0_0, 0, 1;
    %delay 20000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5616afb334b0_0, 0, 1;
    %pushi/vec4 20, 0, 32;
T_3.0 %dup/vec4;
    %pushi/vec4 0, 0, 32;
    %cmp/s;
    %jmp/1xz T_3.1, 5;
    %jmp/1 T_3.1, 4;
    %pushi/vec4 1, 0, 32;
    %sub;
    %wait E_0x5616afb1e2e0;
    %vpi_call 2 30 "$display", "time=%0t value=%0d", $time, v0x5616afb33580_0 {0 0 0};
    %jmp T_3.0;
T_3.1 ;
    %pop/vec4 1;
    %vpi_call 2 33 "$display", "Simulation done." {0 0 0};
    %vpi_call 2 34 "$finish" {0 0 0};
    %end;
    .thread T_3;
